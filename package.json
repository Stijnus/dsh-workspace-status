{
  "name": "dsh-workspace-status",
  "version": "0.3.2",
  "description": "Workspace status marks, a pinned-conversation section and pinned-only notifications for the DeepSeek Harness sidebar.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "workspace",
    "status",
    "indicator",
    "pin",
    "pinned",
    "conversation",
    "notification",
    "notify",
    "desktop-notification",
    "sound"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0"
    },
    "catalog": {
      "summary": {
        "en": "Workspace status marks, a pinned-conversation section above the sidebar list and pinned-only notifications: waiting for you, running, recently finished, grouped per workspace and persisted.",
        "zh": "\u4fa7\u8fb9\u680f\u5de5\u4f5c\u533a\u72b6\u6001\u6807\u8bb0\u3001\u5217\u8868\u4e0a\u65b9\u7684\u5df2\u7f6e\u9876\u4f1a\u8bdd\u533a\uff0c\u4ee5\u53ca\u4ec5\u9488\u5bf9\u7f6e\u9876\u4f1a\u8bdd\u7684\u901a\u77e5\uff1a\u7b49\u5f85\u4f60\u5904\u7406\u3001\u8fd0\u884c\u4e2d\u3001\u521a\u521a\u5b8c\u6210\uff1b\u7f6e\u9876\u6309\u5de5\u4f5c\u533a\u5206\u7ec4\u5e76\u6301\u4e45\u4fdd\u5b58\u3002"
      },
      "category": "ui"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-workspace-status.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-workspace-status#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-workspace-status/issues"
  }
}
